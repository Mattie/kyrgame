# Copy this file to deploy/self-host/.env.selfhost.local and edit it.
# Keep the local file private; it contains credentials.

KYRGAME_PUBLIC_HOST=game.example.test
KYRGAME_CORS_ORIGINS=https://game.example.test

POSTGRES_DB=kyrgame
POSTGRES_USER=kyrgame
POSTGRES_PASSWORD=replace-with-a-long-random-password

HTTP_PORT=80
HTTPS_PORT=443

KYRGAME_ADMIN_TOKEN=
KYRGAME_ADMIN_ALLOWLIST_PATH=/config/admin-allowlist.yaml
KYRGAME_RESET_ON_BOOT=0
KYRGAME_SEED_IF_EMPTY=1
KYRGAME_FORCE_HONOR_MODE=0
KYRGAME_RUN_MIGRATIONS=1
KYRGAME_TELEMETRY_DIR=/data/telemetry
KYRGAME_TRUST_PROXY_HEADERS=1
KYRGAME_DB_CONNECT_ATTEMPTS=30
KYRGAME_DB_CONNECT_RETRY_SECONDS=1
