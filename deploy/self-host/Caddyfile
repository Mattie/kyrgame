{$KYRGAME_PUBLIC_HOST} {
	encode zstd gzip
	root * /usr/share/caddy

	@backend {
		path /auth* /public* /i18n* /world* /locations* /objects* /spells* /commands* /players* /sessions* /content* /ws* /docs* /redoc* /openapi.json /admin/*
		not path /admin /admin/
	}
	handle @backend {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up CF-Connecting-IP {remote_host}
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
