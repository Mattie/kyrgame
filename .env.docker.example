# Docker Compose development defaults.
# For local overrides, point Make at a private env file:
#   make ENV_FILE=.env.docker.local up

POSTGRES_DB=kyrgame
POSTGRES_USER=kyrgame
POSTGRES_PASSWORD=kyrgame
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=
VITE_WS_URL=
KYRGAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

KYRGAME_ADMIN_TOKEN=
KYRGAME_ADMIN_ALLOWLIST_PATH=/config/admin-allowlist.yaml
KYRGAME_RESET_ON_BOOT=0
KYRGAME_SEED_IF_EMPTY=1
KYRGAME_RUN_MIGRATIONS=1
KYRGAME_TELEMETRY_DIR=/data/telemetry
KYRGAME_TRUST_PROXY_HEADERS=0
KYRGAME_DB_CONNECT_ATTEMPTS=30
KYRGAME_DB_CONNECT_RETRY_SECONDS=1

# Optional Cloudflare tunnel profile. Keep the real token in a private local env file.
CLOUDFLARE_TUNNEL_TOKEN=
KYRGAME_ALLOW_CLOUDFLARE_TUNNEL=0
KYRGAME_BACKEND_PROXY_TARGET=http://backend:8000
KYRGAME_VITE_ALLOWED_HOSTS=willow.eventscripts.com
KYRGAME_VITE_USE_POLLING=1
